import random

class Tetrimino:
    def __init__(self):
        self.shape = [
            [1, 1],
            [1, 0]
        ]
        self.position = [3, 4]

    def rotate(self):
        rotated_shape = []
        for row in self.shape:
            rotated_row = []
            for col in range(len(row)):
                rotated_row.append(row[-col - 1])
            rotated_shape.append(rotated_row)
        return rotated_shape

    def drop(self):
        if all(cell == ' ' for cell in self.shape[0]):
            self.position[0] -= 1
        else:
            self.position[0] += 1

class TetrisBoard:
    def __init__(self):
        self.board = [[' ' for _ in range(10)] for _ in range(20)]
        self.tetrimino = Tetrimino()
        self.game_over = False
        self.score = 0

    def place_tetrimino(self):
        for y, row in enumerate(self.tetrimino.shape):
            for x, cell in enumerate(row):
                if cell != ' ':
                    self.board[y + self.tetrimino.position[0]][x + self.tetrimino.position[1]] = '*'

    def clear_lines(self):
        cleared_rows = []
        for y in range(20):
            if all(cell == '*' for cell in self.board[y]):
                cleared_rows.append(y)
        for row in cleared_rows:
            del self.board[row]
            self.board.insert(0, [' ' for _ in range(10)])
        self.score += len(cleared_rows)

    def move_tetrimino(self, direction):
        if direction == 'left':
            new_position = [self.tetrimino.position[0], self.tetrimino.position[1] - 1]
            if all(cell != ' ' for cell in self.board[new_position[0]][new_position[1]:]):
                self.tetrimino.position = new_position
        elif direction == 'right':
            new_position = [self.tetrimino.position[0], self.tetrimino.position[1] + 1]
            if all(cell != ' ' for cell in self.board[new_position[0]][new_position[1]:]):
                self.tetrimino.position = new_position
        elif direction == 'down':
            new_position = [self.tetrimino.position[0] + 1, self.tetrimino.position[1]]
            if all(cell != ' ' for cell in self.board[new_position[0]][new_position[1]:]):
                self.tetrimino.position = new_position
            else:
                self.game_over = True

    def check_collision(self):
        for y, row in enumerate(self.tetrimino.shape):
            for x, cell in enumerate(row):
                if cell != ' ' and (y + self.tetrimino.position[0] >= 20 or x + self.tetrimino.position[1] < 0 or x + self.tetrimino.position[1] >= 10 or self.board[y + self.tetrimino.position[0]][x + self.tetrimino.position[1]] != ' '):
                    return True
        return False

    def game_over(self):
        return self.game_over

    def get_score(self):
        return self.score

# Ejemplo de uso:
board = TetrisBoard()
while not board.game_over():
    key = input("Presiona una tecla (left, right, down, quit): ")
    if key == 'quit':
        break
    elif key == 'left':
        board.move_tetrimino('left')
    elif key == 'right':
        board.move_tetrimino('right')
    elif key == 'down':
        board.move_tetrimino('down')

print(f"Fin del juego. Puntaje: {board.get_score()}")
```

Este código implementa el_core de Tetris utilizando un modelo simple para la pieza actual y la tabla de juego. A medida que se mueve la pieza, se verifica si colisiona con las paredes o otras piezas. Si se colisiona, el juego se detiene y se muestra el puntaje final.
