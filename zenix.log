/* Estilos básicos */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background-color: #f2f2f2;
  color: #333;
}

/* Sección principal */
.container {
  max-width: 800px;
  margin: 40px auto;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

/* Barra de navegación */
.navbar {
  background-color: #333;
  color: #fff;
  padding: 10px;
  border-bottom: 1px solid #666;
}

.navbar ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: space-between;
}

.navbar li {
  margin-right: 20px;
}

.navbar a {
  color: #fff;
  text-decoration: none;
  transition: color 0.2s ease-in-out;
}

.navbar a:hover {
  color: #ccc;
}

/* Card de la mayonesa */
.card-mayonesa {
  background-color: #f5f5f5;
  border-radius: 10px;
  padding: 20px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.card-mayonesa h2 {
  margin-top: 0;
}

.card-mayonesa p {
  font-size: 18px;
  color: #666;
}

/* Tarjetas de la mayonesa */
.cards-mayonesa {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.card-mayonesa--item {
  margin: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  width: calc(33.33% - 40px);
}

.card-mayonesa--item:hover {
  transform: translateY(-5px);
}

/* Botón de llamada */
.call-to-action {
  background-color: #333;
  color: #fff;
  padding: 10px 20px;
  border-radius: 10px;
  cursor: pointer;
}

.call-to-action:hover {
  background-color: #444;
}
```
